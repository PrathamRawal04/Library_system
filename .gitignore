# Create .gitignore with a heredoc
@"
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
ENV/
env/

# Python env files
*.env
.env

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Logs and databases
*.log
*.sqlite3

# Streamlit cache and uploads
.streamlit/
uploads/

# Pytest
.cache/
.pytest_cache/

# Coverage
htmlcov/
.coverage

# Secrets and keys
*.pem
*.key
"@ > .gitignore
